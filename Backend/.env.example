# Google Gemini API Key Configuration
# Get your key at https://ai.google.dev/
# Support for API key rotation: provide multiple comma-separated keys
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration (Origins permitted to connect to this backend)
# Provide a comma-separated list of your deployment URLs (e.g. Vercel, Netlify)
# If empty, defaults to localhost fallback URLs
ALLOWED_ORIGINS=http://localhost:5173,https://your-app-frontend.vercel.app

